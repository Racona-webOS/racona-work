\t\t</tr>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t<p style=\"margin: 0 0 24px; font-size: 14px; line-height: 1.6; color: #52525b;\">Record the new document on the employee's page, Documents tab, with “New version”. All expiring and missing documents are listed on the Documents page.</p>\n\t\t\t\t\t\t\t<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td align=\"center\" style=\"padding: 0 0 8px;\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"{{appUrl}}\" style=\"display: inline-block; padding: 12px 24px; background-color: #3b82f6; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 500; font-size: 14px;\">Open</a>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"padding: 24px 32px; border-top: 1px solid #e4e4e7;\">\n\t\t\t\t\t\t\t<p style=\"margin: 0; font-size: 12px; color: #a1a1aa; text-align: center;\">You received this email because you manage employee documents in {{appName}}.</p>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</table>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n</body>\n</html>",
			"text": "Dear {{recipientName}},\n\nThe following employee documents in {{organizationName}} expire soon or have expired:\n\n{{itemsText}}\n\nRecord the new document on the employee's page, Documents tab, with “New version”: {{appUrl}}\n\nYou received this email because you manage employee documents in {{appName}}.\n\n{{appName}}"
