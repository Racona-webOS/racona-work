t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t<p style=\"margin: 0 0 16px; font-size: 14px; line-height: 1.6; color: #52525b;\">Please add the entries on the project’s Work log tab. If you were on leave on one of these days, record the leave.</p>\n\t\t\t\t\t\t\t{{escalationNoteHtml}}\n\t\t\t\t\t\t\t<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td align=\"center\" style=\"padding: 0 0 8px;\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"{{appUrl}}\" style=\"display: inline-block; padding: 12px 24px; background-color: #3b82f6; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 500; font-size: 14px;\">Open</a>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"padding: 24px 32px; border-top: 1px solid #e4e4e7;\">\n\t\t\t\t\t\t\t<p style=\"margin: 0; font-size: 12px; color: #a1a1aa; text-align: center;\">You received this email because your work log is checked in {{appName}}.</p>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</table>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n</body>\n</html>",
			"text": "Dear {{recipientName}},\n\nIn {{organizationName}}, you have not recorded a work log entry in any project for these working days yet:\n\n{{itemsText}}\n\nPlease add the entries on the project’s Work log tab. If you were on leave on one of these days, record the leave: {{appUrl}}\n\n{{escalationNoteText}}You received this email because your work log is checked in {{appName}}.\n\n{{appName}}"
