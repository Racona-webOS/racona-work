\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"padding: 24px 32px; border-top: 1px solid #e4e4e7;\">\n\t\t\t\t\t\t\t<p style=\"margin: 0; font-size: 12px; color: #a1a1aa; text-align: center;\">You received this email because the details of your trips in {{appName}} have changed.</p>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</table>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n</body>\n</html>",
