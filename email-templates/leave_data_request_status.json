	"locales": {
		"hu": {
			"subject": "Adatbejelentésed: {{statusLabel}}",
			"html": "<!DOCTYPE html>\n<html>\n<head>\n\t<meta charset=\"utf-8\">\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\t<title>Adatbejelentés {{statusLabel}}</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #f4f4f5;\">\n\t<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color: #f4f4f5;\">\n\t\t<tr>\n\t\t\t<td align=\"center\" style=\"padding: 48px 24px;\">\n\t\t\t\t<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width: 520px; background-color: #ffffff; border-radius: 8px;\">\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td align=\"center\" style=\"padding: 32px 32px 24px;\">\n\t\t\t\t\t\t\t<span style=\"font-size: 24px; font-weight: 700; color: #3b82f6;\">{{appNameHtml}}</span>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"padding: 0 32px 24px;\">\n\t\t\t\t\t\t\t<h1 style=\"margin: 0 0 16px; font-size: 20px; font-weight: 600; color: #18181b; text-align: center;\">Az adatbejelentésedet {{statusSentence}}</h1>\n\t\t\t\t\t\t\t<p style=\"margin: 0 0 16px; font-size: 14px; line-height: 1.6; color: #52525b;\">Kedves {{recipientNameHtml}}!</p>\n\t\t\t\t\t\t\t<p style=\"margin: 0 0 24px; font-size: 14px; line-height: 1.6; color: #52525b;\">A(z) <strong>{{organizationNameHtml}}</strong> szervezetben beadott adatbejelentésedet elbírálták. Ha kérdésed van, keresd a HR-t.</p>\n\t\t\t\t\t\t\t<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color: #f9fafb; border-radius: 6px; margin-bottom: 24px;\">\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td style=\"padding: 16px 20px;\">\n\t\t\t\t\t\t\t\t\t\t<p style=\"margin: 0 0 8px; font-size: 12px; font-weight: 600; color: #52525b; text-transform: uppercase; letter-spacing: 0.05em;\">A bejelentés</p>\n\t\t\t\t\t\t\t\t\t\t<p style=\"margin: 0 0 4px; font-size: 14px; color: #18181b;\"><strong>Állapot:</strong> <span style=\"display: inline-block; padding: 2px 10px; border-radius: 999px; background-color: {{statusColor}}; color: #ffffff; font-size: 13px; font-weight: 600;\">{{statusLabel}}</span></p>\n\t\t\t\t\t\t\t\t\t\t<p style=\"margin: 0 0 4px; font-size: 14px; color: #18181b;\"><strong>Bejelentés:</strong> {{summaryHtml}}</p>\n\t\t\t\t\t\t\t\t\t\t{{noteHtml}}\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td align=\"center\" style=\"padding: 0 0 8px;\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"{{appUrl}}\" style=\"display: inline-block; padding: 12px 24px; background-color: #3b82f6; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 500; font-size: 14px;\">Szabadságaim megnyitása</a>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"padding: 24px 32px; border-top: 1px solid #e4e4e7;\">\n\t\t\t\t\t\t\t<p style=\"margin: 0; font-size: 12px; color: #a1a1aa; text-align: center;\">Ezt az emailt azért kaptad, mert a(z) {{appName}} rendszerben beadott adatbejelentésed állapota megváltozott.</p>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</table>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n</body>\n</html>",
			"text": "Kedves {{recipientName}}!\n\nAz adatbejelentésedet {{statusSentence}} a(z) {{organizationName}} szervezetben. Ha kérdésed van, keresd a HR-t.\n\nA bejelentés:\n  Állapot: {{statusLabel}}\n  Bejelentés: {{summary}}{{noteText}}\n\nA szabadságaidat itt éred el: {{appUrl}}\n\nEzt az emailt azért kaptad, mert a(z) {{appName}} rendszerben beadott adatbejelentésed állapota megváltozott.\n\n{{appName}}"
		},
		"en": {
			"subject": "Your data change request: {{statusLabel}}",
			"html": "<!DOCTYPE html>\n<html>\n<head>\n\t<meta charset=\"utf-8\">\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\t<title>Data change request {{statusLabel}}</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #f4f4f5;\">\n\t<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color: #f4f4f5;\">\n\t\t<tr>\n\t\t\t<td align=\"center\" style=\"padding: 48px 24px;\">\n\t\t\t\t<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width: 520px; background-color: #ffffff; border-radius: 8px;\">\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td align=\"center\" style=\"padding: 32px 32px 24px;\">\n\t\t\t\t\t\t\t<span style=\"font-size: 24px; font-weight: 700; color: #3b82f6;\">{{appNameHtml}}</span>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"padding: 0 32px 24px;\">\n\t\t\t\t\t\t\t<h1 style=\"margin: 0 0 16px; font-size: 20px; font-weight: 600; color: #18181b; text-align: center;\">Your data change request {{statusSentence}}</h1>\n\t\t\t\t\t\t\t<p style=\"margin: 0 0 16px; font-size: 14px; line-height: 1.6; color: #52525b;\">Dear {{recipientNameHtml}},</p>\n\t\t\t\t\t\t\t<p style=\"margin: 0 0 24px; font-size: 14px; line-height: 1.6; color: #52525b;\">A decision has been made on your data change request in the <strong>{{organizationNameHtml}}</strong> organization. If you have any questions, contact HR.</p>\n\t\t\t\t\t\t\t<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color: #f9fafb; border-radius: 6px; margin-bottom: 24px;\">\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td style=\"padding: 16px 20px;\">\n\t\t\t\t\t\t\t\t\t\t<p style=\"margin: 0 0 8px; font-size: 12px; font-weight: 600; color: #52525b; text-transform: uppercase; letter-spacing: 0.05em;\">Request</p>\n\t\t\t\t\t\t\t\t\t\t<p style=\"margin: 0 0 4px; font-size: 14px; color: #18181b;\"><strong>Status:</strong> <span style=\"display: inline-block; padding: 2px 10px; border-radius: 999px; background-color: {{statusColor}}; color: #ffffff; font-size: 13px; font-weight: 600;\">{{statusLabel}}</span></p>\n\t\t\t\t\t\t\t\t\t\t<p style=\"margin: 0 0 4px; font-size: 14px; color: #18181b;\"><strong>Change:</strong> {{summaryHtml}}</p>\n\t\t\t\t\t\t\t\t\t\t{{noteHtml}}\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t<td align=\"center\" style=\"padding: 0 0 8px;\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"{{appUrl}}\" style=\"display: inline-block; padding: 12px 24px; background-color: #3b82f6; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 500; font-size: 14px;\">Open my leave</a>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"padding: 24px 32px; border-top: 1px solid #e4e4e7;\">\n\t\t\t\t\t\t\t<p style=\"margin: 0; font-size: 12px; color: #a1a1aa; text-align: center;\">You received this email because the status of your data change request in {{appName}} has changed.</p>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</table>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n</body>\n</html>",
			"text": "Dear {{recipientName}},\n\nYour data change request {{statusSentence}} in the {{organizationName}} organization. If you have any questions, contact HR.\n\nRequest:\n  Status: {{statusLabel}}\n  Change: {{summary}}{{noteText}}\n\nYou can see your leave here: {{appUrl}}\n\nYou received this email because the status of your data change request in {{appName}} has changed.\n\n{{appName}}"
		}
	}
}
